{
  "name": "pierre-vieira-site",
  "compatibility_date": "2026-11-01",
  // Every deploy first compiles the résumé from cv/pierre-vieira-cv.tex into public/cv/ (the PDF is not in git).
  "build": { "command": "bash scripts/build-cv.sh --force" },
  // Static assets only: every file of public/ is served as it is, with no Worker script.
  "assets": {
    "directory": "./public",
    // Any unknown path answers with the page, as it has only one.
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  // Custom Domains: the deploy creates their DNS records in the pierrevieira.com zone.
  "routes": [
    { "pattern": "pierrevieira.com", "custom_domain": true },
    { "pattern": "www.pierrevieira.com", "custom_domain": true }
  ]
}
